generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Synced from Clerk via webhook
model User {
  id             String   @id // Clerk user_xxx ID
  email          String   @unique
  name           String?
  imageUrl       String?
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull) // Deprecated
  memberships  OrgMembership[]
  
  projects     Project[]     @relation("ProjectOwner")
  posts        Post[]
  comments     Comment[]
  reactions    Reaction[]
  jobs         Job[]
  joinRequests JoinRequest[]
  notifications Notification[]
  
  // Phase C: Subscription & Payments
  subscription Subscription? 
  // Phase B: AI Chat Logs for Limits
  aiChats      AIChatLog[]
  aiUsage      UserAIUsage?

  @@index([organizationId])
  @@map("users")
}

model UserAIUsage {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id])

  // Daily tracking
  tokensUsedToday    Int      @default(0)
  requestsToday      Int      @default(0)
  lastResetDate      DateTime @default(now())

  // Monthly tracking (for billing)
  tokensUsedMonth    Int      @default(0)
  requestsMonth      Int      @default(0)
  monthStartDate     DateTime @default(now())

  // Rate limiting snapshot
  lastRequestAt      DateTime?
  requestsLastMinute Int      @default(0)

  updatedAt          DateTime @updatedAt
}

model GlobalTokenPool {
  id                 String   @id @default(cuid())
  date               DateTime @unique @default(now()) @db.Date

  // Pool tracking
  totalTokensUsed    Int      @default(0)
  freePoolUsed       Int      @default(0)
  proPoolUsed        Int      @default(0)
  enterprisePoolUsed Int      @default(0)

  // User counts for dynamic calculation
  activeFreeUsers    Int      @default(0)
  activeProUsers     Int      @default(0)

  // Minute-level for RPM limiting (snapshot)
  requestsThisMinute Int      @default(0)
  minuteStartedAt    DateTime @default(now())
}

// Phase C: Subscription Model
model Subscription {
  id              String   @id // Custom Ticket ID / RC Transaction ID / Payment ID
  userId          String   @unique // One active subscription per user (or simple relation)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  planId          String   // "free", "pro_monthly", "pro_yearly", "business"
  status          String   // "active", "canceled", "expired", "past_due"
  provider        String   // "stripe", "revenuecat", "coinbase"
  
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  
  cancelAtPeriodEnd  Boolean  @default(false)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@map("subscriptions")
}

// Phase B: AI Chat Tracking
model AIChatLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  model     String   // "llama-3.1-8b", "gpt-4"
  tokensIn  Int      @default(0)
  tokensOut Int      @default(0)
  
  createdAt DateTime @default(now())

  @@index([userId, createdAt]) // For counting monthly usage
  @@map("ai_chat_logs")
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  joinCode  String   @unique @default(cuid()) // Will be replaced by 8-char code logic
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  members     OrgMembership[]
  projects    Project[]
  invites     OrgInviteLink[]
  joinRequests JoinRequest[]
  jobs        Job[]
  
  // Legacy/Simple relation
  users       User[]

  @@map("organizations")
}

model OrgMembership {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role           String       @default("member") // owner, admin, member
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("org_memberships")
}

model OrgInviteLink {
  id             String       @id @default(cuid())
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creatorId      String
  expiresAt      DateTime
  maxUses        Int          @default(100)
  uses           Int          @default(0)
  isRevoked      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@map("org_invite_links")
}

model JoinRequest {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  status         String       @default("pending") // pending, approved, rejected
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([userId, organizationId]) // Only one pending request per user/org
  @@index([organizationId])
  @@map("join_requests")
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String   // info, success, warning, error, invite, join_request
  link      String?  // Action link
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
  @@map("notifications")
}

model Project {
  id             String   @id @default(cuid())
  name           String
  organizationId String
  ownerId        String
  status         String   @default("pending") // pending, processing, ready, failed
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  files          File[]
  dashboards     Dashboard[]
  analyses       Analysis[]
  posts          Post[]
  dataSources    DataSource[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, name])
  @@map("projects")
}

model File {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fileName     String
  fileSize     Int
  mimeType     String
  r2Key        String
  r2Url        String
  uploadStatus String   @default("pending") // pending, uploaded, processing, completed, failed
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  analysisResult AnalysisResult?

  @@index([projectId])
  @@index([projectId, uploadStatus])
  @@map("files")
}

model Dashboard {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  style     String   // simple, ml, powerbi
  url       String?  // URL to the dashboard (e.g. Lightdash, Evidence)
  config    Json?    // Store specific config for the engine
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([projectId, createdAt(sort: Desc)])
  @@map("dashboards")
}

model Analysis {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  analysisType String   // e.g. "correlation", "distribution"
  status       String   @default("pending")
  results      Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@map("analyses")
}

model AnalysisResult {
  id          String   @id @default(cuid())
  fileId      String   @unique
  file        File     @relation(fields: [fileId], references: [id], onDelete: Cascade)
  manifestUrl String?
  parquetUrl  String?
  stats       Json?
  createdAt   DateTime @default(now())

  @@map("analysis_results")
}

model DataSource {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name         String
  type         String   // "upload", "url", "api", "google-sheets", "s3"
  config       Json?    // Store connection-specific config (URL, headers, etc.)
  status       String   @default("pending") // pending, fetching, processing, ready, error
  lastSyncAt   DateTime?
  errorMessage String?

  // Linked file (the fetched/uploaded data)
  fileId       String?
  file         File?    @relation(fields: [fileId], references: [id])

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@index([status])
  @@map("data_sources")
}

model Post {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  comments  Comment[]
  reactions Reaction[]

  @@index([projectId])
  @@index([projectId, createdAt(sort: Desc)])
  @@index([userId])
  @@map("posts")
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
  @@map("comments")
}

model Reaction {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([postId, userId, emoji])
  @@index([postId])
  @@index([userId])
  @@map("reactions")
}

model Job {
  id        String   @id @default(cuid())
  type      String   // "csv_ingest", "plot_generation", "ai_insight"
  status    String   @default("queued") // queued, running, done, failed
  progress  Int      @default(0)
  payload   Json?
  result    Json?
  error     String?
  
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  orgId     String?
  org       Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([orgId])
  @@index([status])
  @@map("jobs")
}
